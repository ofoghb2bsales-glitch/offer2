<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#e71948">
  <meta name="description" content="محاسبه‌گر پیشنهاد رفاهیات سازمانی افق کوروش برای سازمان طرف قرارداد">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23e71948'/%3E%3Ccircle cx='32' cy='32' r='19' fill='none' stroke='white' stroke-width='5'/%3E%3Ccircle cx='27' cy='32' r='7' fill='none' stroke='white' stroke-width='5'/%3E%3Cpath d='M39 22 31 32l8 10' fill='none' stroke='white' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <title>پیشنهاد رفاهیات سازمانی | افق کوروش</title>
  <style>
    :root {
      --brand: #e71948;
      --brand-deep: #bd0d35;
      --brand-soft: #fff0f4;
      --ink: #171c24;
      --text: #343b46;
      --muted: #697482;
      --line: #e5e8ed;
      --surface: #ffffff;
      --canvas: #f3f5f7;
      --radius-xl: 28px;
      --radius-lg: 20px;
      --radius-md: 15px;
      --shadow: 0 24px 70px rgba(17, 24, 34, .10);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-width: 320px;
      color: var(--text);
      background: radial-gradient(circle at 92% -5%, rgba(231, 25, 72, .11), transparent 28rem), var(--canvas);
      font-family: "Vazirmatn", "IRANSansX", "Segoe UI", Tahoma, Arial, sans-serif;
      font-size: 16px;
      line-height: 1.65;
      font-variant-numeric: tabular-nums;
      -webkit-font-smoothing: antialiased;
    }
    button, input { font: inherit; }
    button { cursor: pointer; }
    img { display: block; max-width: 100%; }

    .app-shell {
      width: min(1440px, calc(100% - 32px));
      min-height: calc(100vh - 32px);
      margin: 16px auto;
      overflow: hidden;
      position: relative;
      background: var(--surface);
      border: 1px solid rgba(23, 28, 36, .06);
      border-radius: 32px;
      box-shadow: var(--shadow);
    }
    .brand-line { height: 6px; background: linear-gradient(90deg, var(--brand-deep), var(--brand) 55%, #ff6a86); }
    .topbar {
      min-height: 80px;
      padding: 12px clamp(20px, 4vw, 52px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      background: #fff;
      border-bottom: 1px solid var(--line);
    }
    .brand-cluster { min-width: 0; display: flex; align-items: center; gap: 18px; }
    .ok-logo-viewport {
      width: 184px;
      height: 48px;
      overflow: hidden;
      position: relative;
      flex: 0 0 auto;
      background: #fff;
    }
    .ok-logo-viewport img {
      width: 210px;
      height: 210px;
      max-width: none;
      position: absolute;
      top: -84px;
      left: -14px;
      object-fit: contain;
    }
    .brand-separator { width: 1px; height: 34px; background: var(--line); }
    .proposal-name { min-width: 0; }
    .proposal-name strong, .proposal-name span { display: block; }
    .proposal-name strong { color: var(--ink); font-size: .91rem; line-height: 1.5; white-space: nowrap; }
    .proposal-name span { margin-top: 1px; color: var(--muted); font-size: .72rem; }
    .actions { display: flex; gap: 9px; flex: 0 0 auto; }
    .icon-button {
      min-height: 42px;
      padding: 0 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: var(--text);
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      transition: transform .18s ease, border-color .18s ease, color .18s ease;
    }
    .icon-button:hover { color: var(--brand); border-color: rgba(231, 25, 72, .35); transform: translateY(-1px); }
    .icon-button svg { width: 18px; height: 18px; }
    .page-content { padding: clamp(22px, 3.5vw, 48px); }

    .hero {
      margin-bottom: 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 350px;
      gap: 22px;
      align-items: stretch;
    }
    .hero-copy {
      min-height: 220px;
      padding: clamp(25px, 4vw, 44px);
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      color: #fff;
      border-radius: var(--radius-xl);
      background: radial-gradient(circle at 0 100%, rgba(231, 25, 72, .25), transparent 23rem), linear-gradient(135deg, #202934, #121820 72%);
    }
    .hero-copy::after {
      content: "";
      width: 260px;
      height: 260px;
      position: absolute;
      left: -140px;
      bottom: -170px;
      border: 52px solid rgba(231, 25, 72, .16);
      border-radius: 50%;
    }
    .eyebrow { margin: 0 0 7px; color: #ff8ca4; font-size: .82rem; font-weight: 780; }
    h1 { max-width: 790px; margin: 0; color: #fff; font-size: clamp(1.72rem, 3vw, 2.72rem); line-height: 1.35; letter-spacing: -.035em; }
    .hero-description { max-width: 760px; margin: 12px 0 0; color: #cbd2da; font-size: .94rem; }
    .rate-row { margin-top: 20px; display: flex; gap: 9px; flex-wrap: wrap; }
    .rate-chip {
      padding: 7px 11px;
      display: inline-flex;
      align-items: baseline;
      gap: 5px;
      color: #fff;
      border: 1px solid rgba(255, 255, 255, .14);
      border-radius: 999px;
      background: rgba(255, 255, 255, .07);
      font-size: .74rem;
    }
    .rate-chip strong { color: #ff8ca4; font-size: .96rem; }
    .brand-visual { min-height: 220px; overflow: hidden; position: relative; border-radius: var(--radius-xl); background: #f5f5f5; }
    .brand-visual img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: 50% 77%; }
    .brand-visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(104, 0, 23, .16)); pointer-events: none; }

    .calculator { display: grid; grid-template-columns: minmax(420px, .9fr) minmax(540px, 1.25fr); gap: 20px; align-items: start; }
    .panel { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-xl); background: #fff; }
    .panel-heading { padding: 22px 24px 16px; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
    .panel-title-wrap { display: flex; align-items: center; gap: 10px; }
    .step-number { width: 32px; height: 32px; display: grid; place-items: center; flex: 0 0 auto; color: var(--brand); border-radius: 10px; background: var(--brand-soft); font-size: .86rem; font-weight: 800; }
    h2 { margin: 0; color: var(--ink); font-size: 1.12rem; line-height: 1.5; }
    .panel-meta { color: var(--muted); font-size: .72rem; white-space: nowrap; }
    .input-panel { background: #fbfcfd; }
    .input-grid { padding: 0 24px 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; }
    .field {
      min-width: 0;
      padding: 14px 15px 12px;
      display: block;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: #fff;
      transition: border-color .18s ease, box-shadow .18s ease;
    }
    .field:focus-within { border-color: rgba(231, 25, 72, .65); box-shadow: 0 0 0 4px rgba(231, 25, 72, .07); }
    .field-label { min-height: 24px; display: block; color: #424b57; font-size: .82rem; font-weight: 720; }
    .input-row { margin-top: 4px; display: flex; align-items: center; gap: 8px; }
    .field input { width: 100%; min-width: 0; padding: 0; color: var(--ink); background: transparent; border: 0; outline: 0; font-size: 1.18rem; font-weight: 790; direction: ltr; text-align: right; }
    .unit { flex: 0 0 auto; color: var(--muted); font-size: .72rem; white-space: nowrap; }
    .field-note { min-height: 19px; margin: 4px 0 0; display: block; color: var(--muted); font-size: .70rem; }
    .method-note { grid-column: 1 / -1; overflow: hidden; border: 1px solid #ffd2dc; border-radius: var(--radius-md); background: var(--brand-soft); }
    .method-note summary { padding: 12px 14px; display: flex; align-items: center; gap: 9px; color: #8d1732; font-size: .78rem; font-weight: 750; list-style: none; cursor: pointer; }
    .method-note summary::-webkit-details-marker { display: none; }
    .method-note summary::before { content: "+"; width: 22px; height: 22px; display: grid; place-items: center; flex: 0 0 auto; color: #fff; border-radius: 7px; background: var(--brand); font-size: .92rem; }
    .method-note[open] summary::before { content: "−"; }
    .method-note p { margin: 0; padding: 0 14px 14px; color: #6f3441; font-size: .75rem; line-height: 1.8; }

    .result-panel {
      color: #fff;
      border: 0;
      background: radial-gradient(circle at 5% 5%, rgba(255, 255, 255, .07), transparent 18rem), linear-gradient(145deg, #202a36, #111820 67%, #222b36);
      scroll-margin-top: 12px;
    }
    .result-panel h2 { color: #fff; }
    .result-panel .step-number { color: #fff; background: var(--brand); }
    .result-panel .panel-meta { color: #adb6c0; }
    .result-grid { padding: 0 24px 16px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .result-card { min-height: 166px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255, 255, 255, .11); border-radius: 18px; background: rgba(255, 255, 255, .055); }
    .result-card.primary { grid-column: 1 / -1; min-height: 154px; border-color: rgba(255, 111, 140, .42); background: linear-gradient(135deg, rgba(231, 25, 72, .34), rgba(231, 25, 72, .13)); }
    .result-card.per-person-card { grid-column: 1 / -1; min-height: 142px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(205px, .46fr); gap: 14px; }
    .per-person-main { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
    .estimate-box {
      min-width: 0;
      padding: 13px 14px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, .08);
      border-radius: 14px;
      background: rgba(255, 255, 255, .035);
    }
    .estimate-label { margin: 0; color: #929ca7; font-size: .68rem; font-weight: 650; }
    .estimate-value { margin-top: 6px; display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
    .estimate-value strong { color: #d7dde3; font-size: 1.16rem; line-height: 1.3; }
    .estimate-value span { color: #8f99a4; font-size: .62rem; }
    .estimate-note { margin: 5px 0 0; color: #7e8995; font-size: .60rem; line-height: 1.6; }
    .result-label { margin: 0; color: #dfe4ea; font-size: .84rem; font-weight: 680; }
    .result-value { margin: 9px 0 5px; display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap; }
    .result-value strong { max-width: 100%; color: #fff; font-size: clamp(1.58rem, 2.5vw, 2.25rem); line-height: 1.2; letter-spacing: -.035em; overflow-wrap: anywhere; }
    .primary .result-value strong { font-size: clamp(2rem, 3.1vw, 2.75rem); }
    .result-value span { color: #c0c8d1; font-size: .73rem; }
    .result-explain { margin: 0; color: #aab4bf; font-size: .70rem; line-height: 1.75; }
    .primary .result-explain { color: #e4bbc4; }
    .result-status { min-height: 54px; margin: 0 24px 22px; padding: 10px 13px; display: flex; align-items: center; gap: 10px; color: #c9d0d7; border: 1px solid rgba(255, 255, 255, .09); border-radius: 14px; background: rgba(255, 255, 255, .04); font-size: .75rem; }
    .status-mark { width: 28px; height: 28px; display: grid; place-items: center; flex: 0 0 auto; color: #6ce0a4; border-radius: 50%; background: rgba(41, 184, 112, .13); }
    .status-mark svg { width: 16px; height: 16px; }
    .result-status.warning { color: #ffd7a2; border-color: rgba(255, 174, 62, .24); background: rgba(255, 155, 19, .08); }
    .result-status.warning .status-mark { color: #ffc46f; background: rgba(255, 155, 19, .14); }

    .formula-strip { margin-top: 20px; padding: 16px 18px; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 16px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: #f8f9fb; }
    .formula-strip strong { color: var(--ink); font-size: .82rem; white-space: nowrap; }
    .formula-list { display: flex; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
    .formula-list span { padding: 5px 9px; color: var(--muted); border: 1px solid var(--line); border-radius: 9px; background: #fff; font-size: .70rem; }
    .footer { padding: 0 clamp(22px, 3.5vw, 48px) 26px; display: flex; align-items: center; justify-content: space-between; gap: 18px; color: #89939e; font-size: .70rem; }
    .footer strong { color: #4b5662; }
    .print-only, .print-document { display: none; }
    .voice-control {
      display: none;
      min-height: 50px;
      padding: 7px 8px 7px 14px;
      position: fixed;
      right: max(14px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
      z-index: 60;
      align-items: center;
      gap: 9px;
      color: #fff;
      border: 1px solid rgba(255, 255, 255, .14);
      border-radius: 999px;
      background: rgba(20, 27, 35, .96);
      box-shadow: 0 12px 34px rgba(10, 15, 22, .24);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
    .voice-control:hover { transform: translateY(-1px); }
    .voice-control:focus-visible { outline: 3px solid rgba(231, 25, 72, .28); outline-offset: 3px; }
    .voice-control-icon {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      color: #fff;
      border-radius: 50%;
      background: var(--brand);
    }
    .voice-control svg { width: 17px; height: 17px; }
    .voice-control .voice-pause-icon { display: none; }
    .voice-control.is-playing .voice-play-icon { display: none; }
    .voice-control.is-playing .voice-pause-icon { display: block; }
    .voice-control.is-playing .voice-control-icon { box-shadow: 0 0 0 5px rgba(231, 25, 72, .16); }
    .voice-control-label { font-size: .72rem; font-weight: 720; white-space: nowrap; }

    @media (max-width: 1050px) {
      .hero { grid-template-columns: minmax(0, 1fr) 285px; }
      .calculator { grid-template-columns: 1fr; }
    }

    @media (max-width: 720px) {
      body { background: #fff; }
      .app-shell { width: 100%; min-height: 100vh; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
      .brand-line { height: 5px; }
      .topbar { min-height: 66px; padding: 8px 14px; gap: 10px; }
      .brand-cluster { gap: 9px; }
      .ok-logo-viewport { width: 150px; height: 40px; }
      .ok-logo-viewport img { width: 185px; height: 185px; top: -74px; left: -13px; }
      .brand-separator, .proposal-name span { display: none; }
      .proposal-name strong { max-width: 76px; overflow: hidden; font-size: .72rem; line-height: 1.45; white-space: normal; }
      .icon-button { width: 40px; min-height: 40px; padding: 0; }
      .button-label { display: none; }
      .page-content { padding: 16px 14px 22px; }
      .hero { margin-bottom: 14px; grid-template-columns: 1fr; gap: 10px; }
      .hero-copy { min-height: 0; padding: 21px 18px; border-radius: 21px; }
      .eyebrow { margin-bottom: 4px; font-size: .72rem; }
      h1 { font-size: 1.5rem; line-height: 1.45; }
      .hero-description { margin-top: 8px; font-size: .82rem; line-height: 1.75; }
      .rate-row { margin-top: 13px; gap: 6px; }
      .rate-chip { padding: 5px 9px; font-size: .68rem; }
      .rate-chip strong { font-size: .85rem; }
      .brand-visual { min-height: 130px; border-radius: 19px; }
      .brand-visual img { object-position: 50% 76%; }
      .calculator { gap: 14px; }
      .panel { border-radius: 21px; }
      .panel-heading { padding: 18px 16px 13px; }
      h2 { font-size: 1rem; }
      .panel-meta { display: none; }
      .input-grid { padding: 0 16px 16px; grid-template-columns: 1fr; gap: 10px; }
      .method-note { grid-column: auto; }
      .field { padding: 13px 13px 10px; }
      .field-label { min-height: 22px; font-size: .79rem; }
      .field input { font-size: 1.12rem; }
      .field-note { font-size: .68rem; line-height: 1.65; }
      .method-note summary { padding: 11px 12px; font-size: .73rem; }
      .method-note p { padding: 0 12px 12px; font-size: .70rem; }
      .result-grid { padding: 0 16px 12px; grid-template-columns: 1fr; gap: 9px; }
      .result-card, .result-card.primary { grid-column: auto; min-height: 132px; padding: 15px; border-radius: 16px; }
      .result-card.per-person-card { grid-column: auto; grid-template-columns: 1fr; gap: 10px; }
      .estimate-box { padding: 12px 13px; }
      .result-label { font-size: .78rem; }
      .result-value { margin: 7px 0 4px; }
      .result-value strong, .primary .result-value strong { font-size: 1.86rem; }
      .result-explain { font-size: .67rem; }
      .result-status { margin: 0 16px 17px; font-size: .70rem; }
      .formula-strip { margin-top: 14px; padding: 14px; grid-template-columns: 1fr; gap: 9px; }
      .formula-list { justify-content: flex-start; }
      .footer { padding: 0 14px 84px; flex-direction: column; align-items: flex-start; gap: 4px; }
      .voice-control { display: inline-flex; }
    }

    @media (max-width: 390px) {
      .proposal-name { display: none; }
      .ok-logo-viewport { width: 145px; }
      .hero-description { font-size: .78rem; }
      .brand-visual { min-height: 112px; }
    }

    @media print {
      @page { size: A4 portrait; margin: 0; }
      html, body { width: 210mm; height: 297mm; min-width: 0; }
      body {
        margin: 0;
        overflow: hidden;
        background: #fff;
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }
      .app-shell { display: none !important; }
      .voice-control, #introAudio { display: none !important; }
      .print-document {
        width: 210mm;
        height: 297mm;
        margin: 0;
        display: block !important;
        overflow: hidden;
        position: relative;
        direction: rtl;
        color: #22242a;
        background: #fff;
        font-family: Tahoma, Arial, sans-serif;
      }
      .print-letterhead {
        width: 210mm;
        height: 297mm;
        position: absolute;
        inset: 0;
        z-index: 0;
        object-fit: cover;
      }
      .print-meta {
        position: absolute;
        top: 25mm;
        left: 18mm;
        z-index: 1;
        display: grid;
        gap: 1.5mm;
        direction: rtl;
        color: #363a42;
        font-size: 8pt;
      }
      .print-content {
        position: absolute;
        top: 46mm;
        right: 18mm;
        left: 18mm;
        z-index: 1;
        font-size: 8.6pt;
        line-height: 1.75;
      }
      .print-recipient { margin-bottom: 2mm; color: #2a2d33; font-size: 9.5pt; font-weight: 700; }
      .print-recipient strong { display: inline-block; margin-top: 1mm; }
      .print-title {
        margin: 0 0 2mm;
        color: #bd0d35;
        font-size: 15pt;
        line-height: 1.55;
        letter-spacing: -.02em;
      }
      .print-lead { margin: 0 0 3mm; color: #4d535c; }
      .print-section {
        margin-top: 3mm;
        padding: 3mm;
        border: .3mm solid #e2e4e8;
        border-radius: 3mm;
        background: rgba(255,255,255,.94);
        break-inside: avoid;
      }
      .print-section-title {
        margin: 0 0 2mm;
        color: #20242b;
        font-size: 9.5pt;
        font-weight: 800;
      }
      .print-values {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.7mm 5mm;
      }
      .print-value-row {
        min-width: 0;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 3mm;
        padding-bottom: 1.2mm;
        border-bottom: .25mm solid #eceef1;
      }
      .print-value-row span { color: #626973; }
      .print-value-row strong { color: #20242b; text-align: left; white-space: nowrap; }
      .print-output-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2mm;
      }
      .print-output {
        min-height: 18mm;
        padding: 2.5mm;
        border: .3mm solid #e6e8eb;
        border-radius: 2.5mm;
        background: #fafbfc;
      }
      .print-output.highlight {
        border-color: #f1a9ba;
        background: #fff2f5;
      }
      .print-output span { display: block; color: #626973; font-size: 7.6pt; }
      .print-output strong { display: block; margin-top: 1.5mm; color: #bd0d35; font-size: 11pt; }
      .print-estimate { margin-top: 1.8mm; padding-top: 1.5mm; border-top: .25mm solid #e2e5e8; }
      .print-estimate span { color: #7e858e; font-size: 6.7pt; }
      .print-estimate strong { margin-top: .5mm; color: #656c75; font-size: 8.2pt; }
      .print-explanation {
        margin: 0;
        padding: 2.5mm 3mm;
        color: #4d535c;
        border-right: 1mm solid #e71948;
        border-radius: 2mm;
        background: rgba(255,240,244,.92);
        font-size: 8pt;
        line-height: 1.9;
      }
      .print-formulas { margin: 2mm 0 0; padding: 0 4mm 0 0; color: #555d67; }
      .print-formulas li { margin: .8mm 0; }
      .print-sender {
        position: absolute;
        right: 18mm;
        bottom: 31mm;
        z-index: 1;
        color: #282c33;
        font-size: 8.5pt;
        font-weight: 800;
      }
    }
  </style>
</head>
<body>
  <main class="app-shell">
    <div class="brand-line" aria-hidden="true"></div>
    <header class="topbar">
      <div class="brand-cluster">
        <span class="ok-logo-viewport" aria-label="افق کوروش"><img src="assets/okcs-logo.png" alt="لوگوی افق کوروش"></span>
        <span class="brand-separator" aria-hidden="true"></span>
        <span class="proposal-name"><strong>پیشنهاد سازمان طرف قرارداد</strong><span>فروش سازمانی افق کوروش</span></span>
      </div>
      <div class="actions">
        <button class="icon-button" type="button" id="resetButton" aria-label="بازنشانی مقادیر">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6"/><path d="M5.2 15a7.5 7.5 0 0 0 12.3 2.5L20 14M4 10l2.5-3.5A7.5 7.5 0 0 1 18.8 9"/></svg>
          <span class="button-label">بازنشانی</span>
        </button>
        <button class="icon-button" type="button" id="printButton" aria-label="چاپ یا ذخیره PDF">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 8V4h10v4M7 17H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M7 14h10v6H7z"/></svg>
          <span class="button-label">چاپ / PDF</span>
        </button>
      </div>
    </header>

    <div class="page-content">
      <section class="hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="eyebrow">راهکار ترکیبی رفاه و افزایش قدرت خرید</p>
          <h1 id="page-title">مدل پیشنهادی تخصیص اعتبار کارکنان سازمان طرف قرارداد</h1>
          <p class="hero-description">ترکیب شارژ مازاد اعتبار ارزاق و پاداش ماهانه سپرده، یک منفعت رفاهی مستمر و قابل‌اندازه‌گیری برای کارکنان ایجاد می‌کند.</p>
          <div class="rate-row" aria-label="نرخ‌های ثابت طرح">
            <span class="rate-chip"><strong>۶٪</strong> شارژ مازاد در هر دوره</span>
            <span class="rate-chip"><strong>۲٫۵٪</strong> پاداش ماهانه رسوب</span>
          </div>
        </div>
        <div class="brand-visual" aria-hidden="true"><img src="assets/welfare-visual.png" alt=""></div>
      </section>

      <section class="calculator" aria-label="محاسبه‌گر پیشنهاد رفاهی">
        <section class="panel input-panel" aria-labelledby="inputs-title">
          <div class="panel-heading">
            <div class="panel-title-wrap"><span class="step-number">۱</span><h2 id="inputs-title">ورودی‌های طرح</h2></div>
            <span class="panel-meta">سازمانی: میلیارد | هر نفر: میلیون تومان</span>
          </div>
          <div class="input-grid">
            <label class="field">
              <span class="field-label">تعداد پرسنل</span>
              <span class="input-row"><input id="employees" name="employees" inputmode="numeric" value="5000" autocomplete="off" aria-describedby="employeesNote"><span class="unit">نفر</span></span>
              <span class="field-note" id="employeesNote">تعداد کارکنان مشمول طرح</span>
            </label>
            <label class="field">
              <span class="field-label">شارژ اعتبار مدنظر سازمان برای هر نفر</span>
              <span class="input-row"><input id="perPersonCredit" name="perPersonCredit" inputmode="decimal" value="10" autocomplete="off" aria-describedby="creditNote"><span class="unit">میلیون تومان</span></span>
              <span class="field-note" id="creditNote">اعتبار پایه یک نوبت برای کل پرسنل: ۵۰ میلیارد تومان</span>
            </label>
            <label class="field">
              <span class="field-label">دفعات خرج کامل اعتبار در سال</span>
              <span class="input-row"><input id="annualCycles" name="annualCycles" inputmode="numeric" value="2" autocomplete="off" aria-describedby="cyclesNote"><span class="unit">دفعه</span></span>
              <span class="field-note" id="cyclesNote">هر مصرف کامل و شارژ مجدد، یک دوره است</span>
            </label>
            <label class="field">
              <span class="field-label">کل مبلغ واریز اولیه سازمان</span>
              <span class="input-row"><input id="initialPayment" name="initialPayment" inputmode="decimal" value="300" autocomplete="off" aria-describedby="paymentNote"><span class="unit">میلیارد تومان</span></span>
              <span class="field-note" id="paymentNote">شامل اعتبار اولیه و سپرده یک‌ساله</span>
            </label>
            <details class="method-note">
              <summary>شارژ مازاد ۶٪ و رسوب سپرده چگونه محاسبه می‌شود؟</summary>
              <p>در هر بار شارژ اعتبار ارزاق، افق کوروش معادل ۶٪ از مبلغ شارژ را، به صورت پاداش مازاد روی کارت کارکنان شارژ می‌کند. پس از مصرف کامل اعتبار و کسر مبلغ از حقوق کارکنان، شارژ مجدد نیز با همین نرخ انجام می‌شود. رسوب سپرده برابر است با کل واریز اولیه سازمان منهای اعتبار پایه یک نوبت؛ ماهانه ۲٫۵٪ این رسوب، بنا به درخواست سازمان، به کوروش‌کارت کارکنان واریز می‌شود.</p>
            </details>
          </div>
        </section>

        <section class="panel result-panel" id="results" aria-labelledby="results-title" aria-live="polite">
          <div class="panel-heading">
            <div class="panel-title-wrap"><span class="step-number">۲</span><h2 id="results-title">خروجی طرح پیشنهادی</h2></div>
            <span class="panel-meta">محاسبه لحظه‌ای</span>
          </div>
          <div class="result-grid">
            <article class="result-card primary">
              <p class="result-label">کل تخفیف اعطایی در طرح طی یک سال</p>
              <div class="result-value"><strong id="annualTotalBenefit">۸۱</strong><span id="annualTotalBenefitUnit">میلیارد تومان</span></div>
              <p class="result-explain">کل پاداش شارژ اعتبار + پاداش ماهانه کل رسوب × ۱۲ ماه</p>
            </article>
            <article class="result-card">
              <p class="result-label">پاداش ماهانه رسوب سپرده</p>
              <div class="result-value"><strong id="monthlyDepositReward">۶٫۲۵</strong><span id="monthlyDepositRewardUnit">میلیارد تومان</span></div>
              <p class="result-explain" id="residualExplanation">۲٫۵٪ از رسوب ۲۵۰ میلیارد تومانی</p>
            </article>
            <article class="result-card">
              <p class="result-label">پاداش تخصیصی به شارژ اعتبار ارزاق</p>
              <div class="result-value"><strong id="creditReward">۶</strong><span id="creditRewardUnit">میلیارد تومان</span></div>
              <p class="result-explain" id="creditRewardExplanation">۲ دوره × ۵۰ میلیارد تومان × ۶٪</p>
            </article>
            <article class="result-card per-person-card">
              <div class="per-person-main">
                <p class="result-label">پاداش ماهانه رسوب به‌ازای هر نفر</p>
                <div class="result-value"><strong id="monthlyRewardPerPerson">۱٬۲۵۰٬۰۰۰</strong><span>تومان</span></div>
                <p class="result-explain">پاداش ماهانه کل رسوب ÷ تعداد پرسنل</p>
              </div>
              <aside class="estimate-box">
                <p class="estimate-label">پاداش کل تخمینی به‌ازای هر نفر</p>
                <div class="estimate-value"><strong id="estimatedBenefitPerPerson">۱٬۳۵۰٬۰۰۰</strong><span>تومان در ماه</span></div>
                <p class="estimate-note">کل پاداش سالانه ÷ (تعداد پرسنل × ۱۲)</p>
              </aside>
            </article>
          </div>
          <div class="result-status" id="statusBox">
            <span class="status-mark" aria-hidden="true"><svg id="statusIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg></span>
            <span id="statusText">واریز اولیه، اعتبار پایه را پوشش می‌دهد و ۲۵۰ میلیارد تومان رسوب مشمول پاداش باقی می‌ماند.</span>
          </div>
        </section>
      </section>

      <aside class="formula-strip" aria-label="خلاصه روابط محاسباتی">
        <strong>روابط محاسباتی</strong>
        <div class="formula-list">
          <span>اعتبار پایه = تعداد پرسنل × شارژ هر نفر</span>
          <span>رسوب = واریز اولیه − اعتبار پایه یک نوبت</span>
          <span>پاداش رسوب = رسوب × ۲٫۵٪</span>
          <span>پاداش ارزاق = دوره‌ها × اعتبار × ۶٪</span>
          <span>کل تخفیف سال = پاداش ارزاق + ۱۲ × پاداش رسوب</span>
        </div>
      </aside>
    </div>

    <footer class="footer">
      <span><strong>فروش سازمانی افق کوروش</strong> — پیشنهاد اولیه و قابل تنظیم بر اساس پارامترهای نهایی قرارداد</span>
      <span>نرخ‌های محاسباتی: ۶٪ و ۲٫۵٪ ماهانه <span class="print-only">| نسخه ارائه</span></span>
    </footer>
  </main>

  <section class="print-document" aria-label="نسخه چاپی پیشنهاد رفاهیات سازمانی">
    <img class="print-letterhead" src="assets/letterhead.jpg" alt="">
    <div class="print-meta">
      <span>تاریخ: <strong id="printDate">—</strong></span>
      <span>شماره: —</span>
    </div>
    <div class="print-content">
      <div class="print-recipient">مدیریت محترم سازمان طرف قرارداد<br><strong>با سلام و احترام</strong></div>
      <h1 class="print-title">پیشنهاد رفاهیات سازمانی و تخصیص اعتبار کارکنان</h1>
      <p class="print-lead">به استحضار می‌رساند مدل زیر با هدف افزایش قدرت خرید کارکنان و ایجاد منفعت رفاهی مستمر، بر پایه شارژ مازاد اعتبار ارزاق و پاداش ماهانه رسوب سپرده ارائه می‌شود.</p>

      <section class="print-section">
        <h2 class="print-section-title">پارامترهای طرح</h2>
        <div class="print-values">
          <div class="print-value-row"><span>تعداد پرسنل</span><strong id="printEmployees">—</strong></div>
          <div class="print-value-row"><span>شارژ اعتبار هر نفر</span><strong id="printPerPersonCredit">—</strong></div>
          <div class="print-value-row"><span>دفعات خرج کامل اعتبار در سال</span><strong id="printAnnualCycles">—</strong></div>
          <div class="print-value-row"><span>کل مبلغ واریز اولیه سازمان</span><strong id="printInitialPayment">—</strong></div>
          <div class="print-value-row"><span>اعتبار پایه یک نوبت</span><strong id="printTotalCredit">—</strong></div>
          <div class="print-value-row"><span>رسوب مشمول پاداش</span><strong id="printResidual">—</strong></div>
        </div>
      </section>

      <section class="print-section">
        <h2 class="print-section-title">خروجی مالی طرح</h2>
        <div class="print-output-grid">
          <div class="print-output highlight"><span>کل تخفیف اعطایی در طرح طی یک سال</span><strong id="printAnnualTotalBenefit">—</strong></div>
          <div class="print-output"><span>پاداش ماهانه رسوب سپرده</span><strong id="printMonthlyDepositReward">—</strong></div>
          <div class="print-output"><span>پاداش تخصیصی به شارژ اعتبار ارزاق</span><strong id="printCreditReward">—</strong></div>
          <div class="print-output">
            <span>پاداش ماهانه رسوب به‌ازای هر نفر</span>
            <strong id="printMonthlyRewardPerPerson">—</strong>
            <div class="print-estimate"><span>پاداش کل تخمینی به‌ازای هر نفر در ماه</span><strong id="printEstimatedBenefitPerPerson">—</strong></div>
          </div>
        </div>
      </section>

      <section class="print-section">
        <h2 class="print-section-title">توضیح سازوکار محاسبه</h2>
        <p class="print-explanation">در هر بار شارژ اعتبار ارزاق، افق کوروش معادل ۶٪ از مبلغ شارژ را، به صورت پاداش مازاد روی کارت کارکنان شارژ می‌کند. پس از مصرف کامل اعتبار و کسر مبلغ از حقوق کارکنان، شارژ مجدد نیز با همین نرخ انجام می‌شود. رسوب سپرده برابر است با کل واریز اولیه سازمان منهای اعتبار پایه یک نوبت؛ ماهانه ۲٫۵٪ این رسوب، بنا به درخواست سازمان، به کوروش‌کارت کارکنان واریز می‌شود.</p>
        <ul class="print-formulas">
          <li id="printCreditFormula">اعتبار پایه یک نوبت = تعداد پرسنل × شارژ اعتبار هر نفر</li>
          <li>پاداش ماهانه رسوب = رسوب مشمول پاداش × ۲٫۵٪</li>
          <li>پاداش اعتبار ارزاق = دفعات خرج کامل اعتبار × اعتبار پایه یک نوبت × ۶٪</li>
        </ul>
      </section>
    </div>
    <div class="print-sender">شرکت فروشگاه‌های زنجیره‌ای افق کوروش</div>
  </section>

  <audio id="introAudio" preload="auto" playsinline>
    <source src="assets/kourosh-card-intro.m4a" type="audio/mp4">
  </audio>
  <button class="voice-control" type="button" id="voiceControl" aria-label="پخش توضیحات صوتی" aria-pressed="false">
    <span class="voice-control-icon" aria-hidden="true">
      <svg class="voice-play-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
        <path d="M11 5 6.5 9H3v6h3.5l4.5 4z"/><path d="M15 9a4 4 0 0 1 0 6M17.5 6.5a7.5 7.5 0 0 1 0 11"/>
      </svg>
      <svg class="voice-pause-icon" viewBox="0 0 24 24" fill="currentColor">
        <rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>
      </svg>
    </span>
    <span class="voice-control-label" id="voiceControlLabel">پخش توضیحات صوتی</span>
  </button>

  <script>
    (() => {
      'use strict';
      const defaults = { employees: '5000', perPersonCredit: '10', annualCycles: '2', initialPayment: '300' };
      const ids = Object.keys(defaults);
      const fields = Object.fromEntries(ids.map(id => [id, document.getElementById(id)]));
      const faDigits = '۰۱۲۳۴۵۶۷۸۹';
      const arDigits = '٠١٢٣٤٥٦٧٨٩';

      function normalizeDigits(value) {
        return String(value ?? '')
          .replace(/[۰-۹]/g, digit => faDigits.indexOf(digit))
          .replace(/[٠-٩]/g, digit => arDigits.indexOf(digit))
          .replace(/[٬,\s]/g, '')
          .replace('٫', '.');
      }
      function readNumber(field, fallback = 0) {
        const value = Number.parseFloat(normalizeDigits(field.value));
        return Number.isFinite(value) ? value : fallback;
      }
      const faDecimal = new Intl.NumberFormat('fa-IR', { maximumFractionDigits: 2 });
      const faInteger = new Intl.NumberFormat('fa-IR', { maximumFractionDigits: 0 });

      function formatBillion(value, valueElement, unitElement) {
        const absolute = Math.abs(value);
        if (absolute > 0 && absolute < 1) {
          valueElement.textContent = faDecimal.format(value * 1000);
          unitElement.textContent = 'میلیون تومان';
          return;
        }
        valueElement.textContent = faDecimal.format(value);
        unitElement.textContent = 'میلیارد تومان';
      }
      function billionText(value) {
        const absolute = Math.abs(value);
        if (absolute > 0 && absolute < 1) return `${faDecimal.format(value * 1000)} میلیون تومان`;
        return `${faDecimal.format(value)} میلیارد تومان`;
      }
      function setPrintText(id, value) {
        document.getElementById(id).textContent = value;
      }

      setPrintText('printDate', new Intl.DateTimeFormat('fa-IR-u-ca-persian', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).format(new Date()));

      function calculate() {
        const employees = Math.max(0, Math.floor(readNumber(fields.employees)));
        const perPersonCreditMillion = Math.max(0, readNumber(fields.perPersonCredit));
        const totalCreditBillion = (employees * perPersonCreditMillion) / 1000;
        const annualCycles = Math.max(0, Math.floor(readNumber(fields.annualCycles)));
        const initialPaymentBillion = Math.max(0, readNumber(fields.initialPayment));
        const rawResidualBillion = initialPaymentBillion - totalCreditBillion;
        const eligibleResidualBillion = Math.max(0, rawResidualBillion);
        const monthlyDepositRewardBillion = eligibleResidualBillion * 0.025;
        const creditRewardBillion = annualCycles * totalCreditBillion * 0.06;
        const monthlyRewardPerPersonToman = employees > 0 ? (monthlyDepositRewardBillion * 1_000_000_000) / employees : 0;
        const annualTotalBenefitBillion = creditRewardBillion + (monthlyDepositRewardBillion * 12);
        const estimatedBenefitPerPersonToman = employees > 0 ? (annualTotalBenefitBillion * 1_000_000_000) / (employees * 12) : 0;

        formatBillion(annualTotalBenefitBillion, document.getElementById('annualTotalBenefit'), document.getElementById('annualTotalBenefitUnit'));
        formatBillion(monthlyDepositRewardBillion, document.getElementById('monthlyDepositReward'), document.getElementById('monthlyDepositRewardUnit'));
        formatBillion(creditRewardBillion, document.getElementById('creditReward'), document.getElementById('creditRewardUnit'));
        document.getElementById('monthlyRewardPerPerson').textContent = faInteger.format(monthlyRewardPerPersonToman);
        document.getElementById('estimatedBenefitPerPerson').textContent = faInteger.format(estimatedBenefitPerPersonToman);
        document.getElementById('residualExplanation').textContent = rawResidualBillion >= 0 ? `۲٫۵٪ از رسوب ${faDecimal.format(rawResidualBillion)} میلیارد تومانی` : 'به‌دلیل نبود رسوب مثبت، پاداش این بخش صفر است';
        document.getElementById('creditRewardExplanation').textContent = `${faInteger.format(annualCycles)} دوره × ${faDecimal.format(totalCreditBillion)} میلیارد تومان × ۶٪`;
        document.getElementById('creditNote').textContent = `اعتبار پایه یک نوبت برای کل پرسنل: ${billionText(totalCreditBillion)}`;

        setPrintText('printEmployees', `${faInteger.format(employees)} نفر`);
        setPrintText('printPerPersonCredit', `${faDecimal.format(perPersonCreditMillion)} میلیون تومان`);
        setPrintText('printAnnualCycles', `${faInteger.format(annualCycles)} دفعه`);
        setPrintText('printInitialPayment', billionText(initialPaymentBillion));
        setPrintText('printTotalCredit', billionText(totalCreditBillion));
        setPrintText('printResidual', billionText(rawResidualBillion));
        setPrintText('printAnnualTotalBenefit', billionText(annualTotalBenefitBillion));
        setPrintText('printMonthlyDepositReward', billionText(monthlyDepositRewardBillion));
        setPrintText('printCreditReward', billionText(creditRewardBillion));
        setPrintText('printMonthlyRewardPerPerson', `${faInteger.format(monthlyRewardPerPersonToman)} تومان`);
        setPrintText('printEstimatedBenefitPerPerson', `${faInteger.format(estimatedBenefitPerPersonToman)} تومان`);
        setPrintText('printCreditFormula', `اعتبار پایه یک نوبت = ${faInteger.format(employees)} نفر × ${faDecimal.format(perPersonCreditMillion)} میلیون تومان = ${billionText(totalCreditBillion)}`);

        const statusBox = document.getElementById('statusBox');
        const statusText = document.getElementById('statusText');
        const statusIcon = document.getElementById('statusIcon');
        if (employees === 0) {
          statusBox.classList.add('warning');
          statusText.textContent = 'برای محاسبه پاداش ماهانه هر نفر، تعداد پرسنل را وارد کنید.';
          statusIcon.innerHTML = '<path d="M12 8v5M12 17h.01"/><circle cx="12" cy="12" r="9"/>';
        } else if (rawResidualBillion < 0) {
          statusBox.classList.add('warning');
          statusText.textContent = `واریز اولیه برای پوشش اعتبار پایه کافی نیست؛ کسری طرح ${faDecimal.format(Math.abs(rawResidualBillion))} میلیارد تومان است.`;
          statusIcon.innerHTML = '<path d="M12 8v5M12 17h.01"/><circle cx="12" cy="12" r="9"/>';
        } else {
          statusBox.classList.remove('warning');
          statusText.textContent = `واریز اولیه، اعتبار پایه را پوشش می‌دهد و ${faDecimal.format(rawResidualBillion)} میلیارد تومان رسوب مشمول پاداش باقی می‌ماند.`;
          statusIcon.innerHTML = '<path d="m5 12 4 4L19 6"/>';
        }
      }

      ids.forEach(id => fields[id].addEventListener('input', calculate));
      document.getElementById('resetButton').addEventListener('click', () => {
        ids.forEach(id => { fields[id].value = defaults[id]; });
        calculate();
        fields.employees.focus();
      });
      document.getElementById('printButton').addEventListener('click', () => {
        calculate();
        window.print();
      });

      const introAudio = document.getElementById('introAudio');
      const voiceControl = document.getElementById('voiceControl');
      const voiceControlLabel = document.getElementById('voiceControlLabel');
      const mobileVoiceQuery = window.matchMedia('(max-width: 720px)');

      function setVoiceState(state) {
        const isPlaying = state === 'playing';
        voiceControl.classList.toggle('is-playing', isPlaying);
        voiceControl.setAttribute('aria-pressed', String(isPlaying));
        if (isPlaying) {
          voiceControlLabel.textContent = 'توقف توضیحات صوتی';
          voiceControl.setAttribute('aria-label', 'توقف توضیحات صوتی');
        } else if (state === 'blocked') {
          voiceControlLabel.textContent = 'برای شنیدن، لمس کنید';
          voiceControl.setAttribute('aria-label', 'پخش توضیحات صوتی');
        } else if (state === 'ended') {
          voiceControlLabel.textContent = 'پخش دوباره توضیحات';
          voiceControl.setAttribute('aria-label', 'پخش دوباره توضیحات صوتی');
        } else {
          voiceControlLabel.textContent = 'پخش توضیحات صوتی';
          voiceControl.setAttribute('aria-label', 'پخش توضیحات صوتی');
        }
      }

      async function playIntroAudio() {
        try {
          await introAudio.play();
          setVoiceState('playing');
          return true;
        } catch {
          setVoiceState('blocked');
          return false;
        }
      }

      voiceControl.addEventListener('click', () => {
        if (introAudio.paused) playIntroAudio();
        else introAudio.pause();
      });
      introAudio.addEventListener('play', () => setVoiceState('playing'));
      introAudio.addEventListener('pause', () => {
        if (!introAudio.ended) setVoiceState('paused');
      });
      introAudio.addEventListener('ended', () => setVoiceState('ended'));
      introAudio.addEventListener('error', () => {
        voiceControlLabel.textContent = 'فایل صوتی در دسترس نیست';
        voiceControl.disabled = true;
      });

      if (mobileVoiceQuery.matches) {
        window.addEventListener('load', async () => {
          const started = await playIntroAudio();
          if (!started) {
            const unlockAudio = event => {
              if (event.target.closest('#voiceControl')) return;
              playIntroAudio();
            };
            document.addEventListener('pointerdown', unlockAudio, { once: true, capture: true });
          }
        }, { once: true });
      }
      calculate();
    })();
  </script>
</body>
</html>
